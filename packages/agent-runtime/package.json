{
  "name": "@clearideas/agent-runtime",
  "version": "0.4.0",
  "description": "Standalone TypeScript runtime for declarative agents across local and remote infrastructure.",
  "license": "Apache-2.0",
  "author": "Clear Ideas Incorporated",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearideas/agent-runtime.git",
    "directory": "packages/agent-runtime"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build && node ../../scripts/prepare-package-license.mjs",
    "postpack": "node ../../scripts/cleanup-package-license.mjs"
  },
  "dependencies": {
    "@clearideas/agent-runtime-condition-jexl": "0.4.0",
    "@clearideas/agent-runtime-config": "0.4.0",
    "@clearideas/agent-runtime-contracts": "0.4.0",
    "@clearideas/agent-runtime-core": "0.4.0",
    "@clearideas/agent-runtime-execution": "0.4.0",
    "@clearideas/agent-runtime-model-ai-sdk": "0.4.0",
    "@clearideas/agent-runtime-step-loop": "0.4.0",
    "@clearideas/agent-runtime-step-prompt": "0.4.0",
    "@clearideas/agent-runtime-step-standard": "0.4.0",
    "@clearideas/agent-runtime-store-local": "0.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://agent-runtime.clearideas.com/",
  "bugs": {
    "url": "https://github.com/clearideas/agent-runtime/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "agent-runtime",
    "agent-execution",
    "mcp",
    "workflows"
  ]
}
