{
  "name": "@clearideas/agent-runtime-config",
  "version": "0.1.0",
  "description": "Declarative provider, model, connection, and secret composition for Clear Ideas Agent Runtime.",
  "license": "Apache-2.0",
  "author": "Clear Ideas Incorporated",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearideas/agent-runtime.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build && node ../../scripts/prepare-package-license.mjs",
    "postpack": "node ../../scripts/cleanup-package-license.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/cohere": "^4.0.12",
    "@ai-sdk/google": "^4.0.22",
    "@ai-sdk/groq": "^4.0.13",
    "@ai-sdk/openai": "^4.0.18",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/xai": "^4.0.18",
    "@clearideas/agent-runtime-contracts": "0.1.0",
    "@clearideas/agent-runtime-core": "0.1.0",
    "@clearideas/agent-runtime-model-ai-sdk": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.35",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/clearideas/agent-runtime#readme",
  "bugs": {
    "url": "https://github.com/clearideas/agent-runtime/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "agent-runtime",
    "workflows"
  ]
}
