{
  "name": "agent-runtime-workspace",
  "version": "0.1.0",
  "description": "Open-source workspace for the Clear Ideas Agent Runtime.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/generate-runtime-version.mjs && tsc -b tsconfig.json --force",
    "type-check": "node scripts/generate-runtime-version.mjs && tsc -b tsconfig.json --pretty false",
    "test": "node scripts/run-tests.mjs",
    "test:verbose": "npm run test --workspaces --if-present && npm run test:examples",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:metadata": "node scripts/check-package-metadata.mjs",
    "check:tarballs": "node scripts/check-tarballs.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "format": "prettier --write \"package.json\" \"tsconfig.json\" \"*.md\" \".changeset/**/*.{json,md}\" \".github/**/*.{yml,yaml,md}\" \"docs/**/*.{json,md,mjs}\" \"docs/.vitepress/**/*.{ts,js,css}\" \"examples/**/*.{json,md,ts,js,mjs,css,html}\" \"packages/**/*.{json,md,ts,js,mjs,cjs}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"package.json\" \"tsconfig.json\" \"*.md\" \".changeset/**/*.{json,md}\" \".github/**/*.{yml,yaml,md}\" \"docs/**/*.{json,md,mjs}\" \"docs/.vitepress/**/*.{ts,js,css}\" \"examples/**/*.{json,md,ts,js,mjs,css,html}\" \"packages/**/*.{json,md,ts,js,mjs,cjs}\" \"scripts/*.mjs\"",
    "docs:dev": "npm run dev --workspace @clearideas/agent-runtime-docs",
    "docs:build": "npm run build --workspace @clearideas/agent-runtime-docs",
    "docs:check": "npm run check:docs",
    "validate": "npm run format:check && npm run check:metadata && npm run check:boundaries && npm run build && npm test && npm run check:docs && npm run check:tarballs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/generate-runtime-version.mjs",
    "release:check": "npm run validate",
    "release:packages": "changeset publish",
    "test:examples": "node --test examples/patterns/patterns.test.mjs examples/patterns/anthropic-compatibility.test.mjs examples/serving/serving.test.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "example:showcase": "npm --prefix examples/showcase start",
    "test:showcase": "npm --prefix examples/showcase test"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "npm@11.8.0",
  "overrides": {
    "@hono/node-server": "^2.1.3",
    "vitepress": {
      "vite": "^6.4.5"
    }
  },
  "license": "Apache-2.0",
  "author": "Clear Ideas Incorporated",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearideas/agent-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/clearideas/agent-runtime/issues"
  },
  "homepage": "https://github.com/clearideas/agent-runtime#readme",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
