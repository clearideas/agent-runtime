{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "server.ts",
    "doctor.ts",
    "lib/**/*.ts",
    "demos/**/*.ts",
    "test/**/*.ts"
  ]
}
