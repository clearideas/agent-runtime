{
  "name": "@clearideas/agent-runtime-example-showcase",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearideas/agent-runtime.git",
    "directory": "examples/showcase"
  },
  "type": "module",
  "description": "Self-hosted, animated demos of every Clear Ideas Agent Runtime feature set.",
  "scripts": {
    "start": "node server.ts",
    "start:python": "uv run --project ../../python --all-extras python server.py",
    "launch": "node --env-file-if-exists=.env.local launcher/server.ts",
    "doctor": "node doctor.ts",
    "doctor:python": "uv run --project ../../python --all-extras python doctor.py",
    "use-local-runtime": "node scripts/use-local-runtime.mjs",
    "type-check": "tsc -p tsconfig.json",
    "test": "npm run type-check && node --test \"test/*.test.ts\"",
    "test:python": "npm run type-check && node scripts/test-python.mjs"
  },
  "dependencies": {
    "@clearideas/agent-runtime": "file:../../packages/agent-runtime",
    "@clearideas/agent-runtime-sandbox": "file:../../packages/sandbox",
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "@clearideas/consent-analytics": "file:../../vendor/clearideas-consent-analytics-0.1.0-rc.1.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ai": "^7.0.164",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.3"
  }
}
